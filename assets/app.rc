#include <windows.h>
#include "../src/version.h"
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION APP_VERSION_TUPLE
PRODUCTVERSION APP_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "DITASHA\0"
   VALUE "FileDescription", "DITASHA Workspace local desktop workspace\0"
   VALUE "FileVersion", APP_VERSION "\0"
   VALUE "InternalName", "DITASHA-Workspace\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Foxu / DITASHA\0"
   VALUE "OriginalFilename", "DITASHA-Workspace.exe\0"
   VALUE "ProductName", "DITASHA Workspace\0"
   VALUE "ProductVersion", APP_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

101 RCDATA "../vendor/WebView2Loader.dll"
102 RCDATA "../vendor/MicrosoftEdgeWebview2Setup.exe"

103 RCDATA "index.html"

